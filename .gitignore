# Byte-compiled / optimized
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/
wheelhouse/

# Virtual environments
.venv/
venv/
env/

# Test / coverage
